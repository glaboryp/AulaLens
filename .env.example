# Genera un secreto aleatorio para firmar las sesiones
NUXT_AUTH_SECRET=un_secreto_muy_largo_y_seguro

# Origen público de la app (esquema + host, sin path final).
# Es OBLIGATORIO en producción y debe coincidir con la URL que ven los usuarios
# y con la URI de redirección autorizada en Google Cloud Console
# (<AUTH_ORIGIN>/api/auth/callback/google). Ejemplo: https://aulalens.example.com
# En desarrollo, si se omite, se usa http://localhost:3000.
AUTH_ORIGIN=http://localhost:3000

# Opcional. next-auth la usa para construir redirect_uri y las cookies Secure.
# Si no la defines, la app la deriva de AUTH_ORIGIN al arrancar. Si la defines,
# debe apuntar al mismo origen que AUTH_ORIGIN (o la app no arrancará).
# No dependas de VERCEL ni de AUTH_TRUST_HOST para esto.
# NEXTAUTH_URL=http://localhost:3000

# Credenciales obtenidas desde Google Cloud Console
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
